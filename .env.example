# Copy to .env for local development. Production deploys set these as secrets.

# HTTP server
PORT=8080
BASE_URL=http://localhost:8080

# Required in production
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
SUPER_ADMIN_EMAIL=you@example.com

# Storage (relative paths are resolved against the working directory)
DB_PATH=./data/basicbugs.sqlite
ATTACHMENTS_DIR=./data/attachments

# Outbound email (optional in dev — when SMTP_HOST is empty, magic-link mails are logged to stdout)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Basic Bugs <noreply@example.com>"
