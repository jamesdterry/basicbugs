{
  "name": "basicbugs",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source bug tracker aimed at consultants. Vanilla JS/CSS/HTML on Node + Express + SQLite.",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "start:e2e": "PORT=8081 DB_PATH=./data/e2e.sqlite NODE_ENV=test SUPER_ADMIN_EMAIL=admin@e2e.local SESSION_SECRET=e2e-session-secret BASE_URL=http://localhost:8081 SMTP_HOST= node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/seed-e2e.js && playwright test",
    "e2e:ui": "node scripts/seed-e2e.js && playwright test --ui",
    "e2e:headed": "node scripts/seed-e2e.js && playwright test --headed",
    "e2e:install": "playwright install chromium",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/reset-db.js",
    "seed:perf": "node scripts/seed-perf.js",
    "bench:issues": "node scripts/bench-issues-list.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^11.7.0",
    "busboy": "^1.6.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@flydotio/dockerfile": "^0.7.10",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
