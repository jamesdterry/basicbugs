# Template for .env.production — a local, GITIGNORED snapshot of every
# secret/env var set on the live Fly app. The file is for YOUR reference
# (and for replaying `fly secrets set` if you ever need to recreate the
# app); the live values come from Fly's secret store at runtime, not from
# this file.
#
# To create your real .env.production:
#   1. Copy this file:           cp .env.production.example .env.production
#   2. Fill in real values from the sources noted in each section.
#   3. Confirm it's gitignored:  git check-ignore .env.production
#                                → should print ".env.production"
#
# Never commit .env.production. If you ever rotate a secret, update both
# Fly (`fly secrets set KEY=value -a basicbugs`) and this file.

# --- App config (set as Fly secrets / fly.toml [env]) ---------------------
# These are mostly already in fly.toml [env]; listed here for completeness.
NODE_ENV=production
PORT=8080
BASE_URL=https://basicbugs.fly.dev
DB_PATH=/data/basicbugs.sqlite
ATTACHMENTS_DIR=/data/attachments

# --- Application secrets (set via `fly secrets set`) ----------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Magic-link recipient + collapses to developer role on every project.
SUPER_ADMIN_EMAIL=

# --- Outbound email (set via `fly secrets set`) ---------------------------
# When SMTP_HOST is empty, mails are logged to stdout (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Basic Bugs <noreply@example.com>

# --- Tigris / S3 backup (set automatically by `fly storage create`) -------
# After running `fly storage create -a basicbugs` the output prints these
# values once — capture them then. Re-running `fly storage create` rotates
# them. To inspect what's currently set on the app:
#   fly ssh console -a basicbugs -C 'env' | grep -E 'AWS_|BUCKET_NAME'
BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev
AWS_REGION=auto

# --- Backup tuning (optional, set via `fly secrets set`) ------------------
# How many days of daily VACUUM-INTO snapshots to keep in s3://.../snapshots/.
# Litestream WAL retention is configured in litestream.yml (168h).
BACKUP_SNAPSHOT_RETENTION_DAYS=30
